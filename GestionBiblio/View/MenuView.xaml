<Window x:Class="WpfApp1.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="Gestion" Height="700" Width="1300"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">

    <Border CornerRadius="10"   BorderThickness="0" Background="Black" BorderBrush="Transparent">
        <Border CornerRadius="10" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource winBorderColor1}" Offset="0.0"/>
                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                    <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!--Navigation Menu-->
                    <ColumnDefinition Width="250">
                    </ColumnDefinition>
                    <!--Content Section-->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Navigation Menu-->
                <Border CornerRadius="10,0,0,10"
                    Grid.Column="0">
                    <Border.Background >
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <!--BANNER-->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="50"/>

                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal"
                                Height="35"
                                Margin="15,25,0,40" 
                                Grid.Row="0">
                                <TextBlock Text="BIBLIOTHEQUE"
                                   Foreground="{StaticResource titleColor2}"
                                   FontSize="20"
                                   FontFamily="Montserrat"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="10,6,0,5.2"/>
                            </StackPanel>

                            <RadioButton x:Name="btnLivre" Style="{StaticResource menuButton}" Click="btnLivre_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Livre" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="btnLecteur" Style="{StaticResource menuButton}" Click="btnLecteur_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Lecteur" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="btnPreter" Style="{StaticResource menuButton}" Click="btnPreter_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Preter" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                        <Button Style="{StaticResource btnDeconnecter}" Grid.Row="1" Margin="0" Click="Button_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Deconnecter" Style="{StaticResource menuButtonText}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--Main Section-->
                <Border CornerRadius="0,10,10,0"
                    Grid.Column="1">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                            <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                            <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!--CARD LAYOUT-->
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnMinimize" Style="{StaticResource btnWindowController}"
                                        Content="-" 
                                        Background="#28AEED"
                                        Grid.Column="1"
                                        Click="btnMinimize_Click"></Button>
                                <Button x:Name="btnClose" Style="{StaticResource btnWindowController}"
                                        Content="x" 
                                        Background="#DA34AE"
                                        Grid.Column="2"
                                        Click="btnClose_Click"></Button>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="25,0,25,25" >
                            <!-- PANEL LECTEUR-->
                            <Grid x:Name="Lecteur" Grid.Column="1" Panel.ZIndex="3" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--Panel Ajout Modification-->
                                <Border CornerRadius="10 10 0 0 " Grid.Row="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,20,20">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="Listes Des Lecteurs" FontFamily="Montserrat" FontSize="30" Margin="20,0,0,25" Foreground="White"/>
                                            <TextBox x:Name="labelRechercheLecteur"  Width="140" Margin="328,20,0,25" Style="{StaticResource textBoxStyle}" />
                                            <Button x:Name="btnSearchLecteur" Style="{StaticResource btnAjout}"
                                        Content="Recherche" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnSearchLecteur_Click"></Button>
                                            <Button x:Name="btnRefreshLecteur" Style="{StaticResource btnAjout}"
                                        Content="Actualiser" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnRefreshLecteur_Click"></Button>
                                        </StackPanel>


                                        <StackPanel Margin="330, 0, 0, 0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Numero : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="numLecteur" Style="{StaticResource textBoxStyle}" Width="100" />
                                            <TextBlock Text="Nom : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="nomLecteur" Style="{StaticResource textBoxStyle}" Width="100"/>
                                            <TextBlock Text="Prenom : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="prenomLecteur" Style="{StaticResource textBoxStyle}" Width="100"/>
                                            
                                            <Button x:Name="btnAjoutLecteur" Style="{StaticResource btnAjout}"
                                        Content="Ajouter" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnAjoutLecteur_Click_1"></Button>


                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                                <DataGrid  
                                          x:Name="dataGridLecteur" Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" RowHeight="30"
                                          >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding numLecteur}" IsReadOnly="True" CanUserResize="False" Header="Numero" Width="200"/>
                                        <DataGridTextColumn Binding="{Binding nom}" IsReadOnly="True" CanUserResize="False" Header="Nom" Width="350"/>
                                        <DataGridTextColumn Binding="{Binding prenom}" IsReadOnly="True" CanUserResize="False" Header="Prenom" Width="340"/>
                                        <DataGridTemplateColumn Header="Operation" IsReadOnly="True" CanUserResize="False" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>


                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="btnEditLecteur" Style="{StaticResource btnWindowController}"
                                                            Content="-" 
                                                            Background="#28AEED"  
                                                            Grid.Column="1"
                                                            Click="btnEditLecteur_Click"
                                                            Margin="20 0 20 0">
                                                        </Button>
                                                        <Button x:Name="btnDeleteLecteur" Style="{StaticResource btnWindowController}"
                                                            Content="X" 
                                                            Background="#DA34AE"
                                                            Grid.Column="1"
                                                            Click="btnDeleteLecteur_Click">
                                                        </Button>

                                                    </StackPanel>


                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <!--PANEL LIVRE-->
                            <Grid x:Name="Livre" Grid.Column="1" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--Panel Ajout Modification-->
                                <Border CornerRadius="10 10 0 0 " Grid.Row="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,20,20">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="Listes Des Livres" FontFamily="Montserrat" FontSize="30" Margin="20,0,0,25" Foreground="White"/>
                                            <TextBox x:Name="labelRecherche"  Width="140" Margin="328,20,0,25" Style="{StaticResource textBoxStyle}" />
                                            <Button x:Name="btnSearchLivre" Style="{StaticResource btnAjout}"
                                        Content="Recherche" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnSearchLivre_Click"></Button>
                                            <Button x:Name="btnRefreshLivre" Style="{StaticResource btnAjout}"
                                        Content="Actualiser" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnRefreshLivre_Click"></Button>
                                        </StackPanel>
                                        
                                                                                
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Numero : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="numLivre" Style="{StaticResource textBoxStyle}" Width="100" />
                                            <TextBlock Text="Design : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="designLivre" Style="{StaticResource textBoxStyle}" Width="100"/>
                                            <TextBlock Text="Auteur : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="auteurLivre" Style="{StaticResource textBoxStyle}" Width="100"/>
                                            <TextBlock Text="Date : " Style="{StaticResource textBlockStyle}"/>
                                            <DatePicker x:Name="dateLivre" Height="24" Margin="0,5,0,0"/>
                                            <TextBlock Margin="20 0 0 0" Text="Disponible : " Style="{StaticResource textBlockStyle}"/>
                                            <CheckBox x:Name="dispoCheck" IsChecked="True" Margin="10 8 0 0"></CheckBox>
                                            <Button x:Name="btnAjoutLivre" Style="{StaticResource btnAjout}"
                                        Content="Ajouter" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnAjoutLivre_Click"></Button>
                                            
                                          
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                               
                                <DataGrid  
                                          x:Name="dataGridLivre" Grid.Row="1"
                                          AutoGenerateColumns="False"
                                    CanUserAddRows="False" RowHeight="30">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding numLivre}" IsReadOnly="True" CanUserResize="False" Header="Numero" Width="100"/>
                                        <DataGridTextColumn Binding="{Binding design}" IsReadOnly="True" CanUserResize="False" Header="Design" Width="250"/>
                                        <DataGridTextColumn Binding="{Binding auteur}" IsReadOnly="True" CanUserResize="False" Header="Auteur" Width="240"/>
                                        <DataGridTextColumn Binding="{Binding dateEdition}" IsReadOnly="True" CanUserResize="False" Header="Edition" Width="200"/>
                                        <DataGridTextColumn Binding="{Binding disponible}" IsReadOnly="True" CanUserResize="False" Header="Disponible" Width="100"/>
                                        <DataGridTemplateColumn Header="Operation" IsReadOnly="True" CanUserResize="False" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    
                                                        
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button x:Name="btnEdit" Style="{StaticResource btnWindowController}"
                                                            Content="-" 
                                                            Background="#28AEED"
                                                                    
                                                            Grid.Column="1"
                                                            Click="btnEdit_Click"
                                                            Margin="20 0 20 0">
                                                            </Button>
                                                            <Button x:Name="btnDelete" Style="{StaticResource btnWindowController}"
                                                            Content="X" 
                                                            Background="#DA34AE"
                                                            Grid.Column="1"
                                                            Click="btnDelete_Click">
                                                            </Button>

                                                        </StackPanel>
                                                    
                                                   
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <!--PANEL PRETER-->
                            <Grid x:Name="Preter" Grid.Column="1" Panel.ZIndex="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--Panel Ajout Modification-->
                                <Border CornerRadius="10" Grid.Row="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                                            <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="50,0,30,20">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="Listes Des Emprunts" FontFamily="Montserrat" FontSize="30" Margin="20,0,0,25" Foreground="White"/>
                                            <TextBox x:Name="recherchePret"  Width="140" Margin="210,20,0,25" Style="{StaticResource textBoxStyle}" />
                                            <Button x:Name="btnSearchPret" Style="{StaticResource btnAjout}"
                                        Content="Recherche" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnSearchPret_Click"></Button>
                                            <Button x:Name="btnRefreshPret" Style="{StaticResource btnAjout}"
                                        Content="Actualiser" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnRefreshPret_Click"></Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="N°Pret : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="numPret" Style="{StaticResource textBoxStyle}" Width="100" />
                                            <TextBlock Text="N°Lecteur : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="numLecteurPret" Style="{StaticResource textBoxStyle}" Width="100"/>
                                            <TextBlock Text="N°Livre : " Style="{StaticResource textBlockStyle}"/>
                                            <TextBox x:Name="numLivrePret" Style="{StaticResource textBoxStyle}" Width="100"/>
                                            <TextBlock Text="Date : " Style="{StaticResource textBlockStyle}" />
                                            <DatePicker x:Name="dateRetourPret" Width="130" VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        />
                                            <Button x:Name="btnAjoutPret" Style="{StaticResource btnAjout}"
                                        Content="Ajouter" Margin="15,0,0,0"
                                        Background="#DA34AE" Click="btnAjoutPret_Click" ></Button>
                                           
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                                <DataGrid x:Name="dataGridPreter" Grid.Row="1" CanUserAddRows="False" AutoGenerateColumns="False" RowHeight="30">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding numPret}" CanUserResize="False" IsReadOnly="true" Header="N°Pret" Width="50"/>
                                        <DataGridTextColumn Binding="{Binding numLecteur}" CanUserResize="False" IsReadOnly="true" Header="N°Lecteur" Width="50"/>
                                        <DataGridTextColumn Binding="{Binding numLivre}" CanUserResize="False" IsReadOnly="true" Header="N°Livre" Width="50"/>
                                        <DataGridTextColumn Binding="{Binding nom}" CanUserResize="False" IsReadOnly="true" Header="Nom Lecteur" Width="140"/>
                                        <DataGridTextColumn Binding="{Binding design}" CanUserResize="False" IsReadOnly="true" Header="Design Livre" Width="140"/>
                                        <DataGridTextColumn Binding="{Binding auteur}" CanUserResize="False" IsReadOnly="true" Header="Auteur" Width="160"/>
                                        <DataGridTextColumn Binding="{Binding datePret}" CanUserResize="False" IsReadOnly="true" Header="Date Pret" Width="150"/>
                                        <DataGridTextColumn Binding="{Binding dateRetour}" CanUserResize="False" IsReadOnly="true" Header="Date Retour" Width="150"/>
                                        <DataGridTemplateColumn Header="Action" CanUserResize="False" IsReadOnly="true" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="btnEditPreter" Style="{StaticResource btnWindowController}"
                                                            Content="-" 
                                                            Background="#28AEED"
                                                            Grid.Column="1"
                                                            Click="btnEditPreter_Click"
                                                            Margin="20 0 20 0">
                                                        </Button>
                                                        <Button x:Name="btnDeletePreter" Style="{StaticResource btnWindowController}"
                                                            Content="X" 
                                                            Background="#DA34AE"
                                                            Grid.Column="1"
                                                            Click="btnDeletePreter_Click">
                                                        </Button>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>


                    </Grid>

                </Border>
                

            </Grid>
        </Border>
    </Border>


</Window>
